# syntax=docker/dockerfile:1.7
# =============================================================================
# API and worker image.
#
# One image carrying both bundles, with the command choosing which to run:
#
#   node build/api/index.mjs
#   node build/worker/index.mjs
#
# Not two images. They share every dependency and differ only in an entry
# point, so building twice would double the build minutes to produce two
# near-identical layers — and let the two drift to different commits.
#
# The build bundles each service into a single file (scripts/bundle.mjs), so the
# runtime stage carries no workspace node_modules at all — only the one native
# addon esbuild cannot inline.
# =============================================================================

# Node 22 LTS, matching development.
#
# It was 20.18.1, which sat below the >=20.19.4 floor the workspace root
# declares since Expo SDK 54 raised it. `engine-strict` is off, so pnpm would
# only have warned — but a container building on a Node the repository says is
# too old is drift waiting to become a failure, and the version that ran
# `deploy:check` is the one worth shipping.
ARG NODE_VERSION=22.20.0

# ── Dependencies ─────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-slim AS deps
WORKDIR /repo

COPY package.json ./

# Install pnpm directly rather than through corepack.
#
# Corepack bundled with Node 20.x carries npm registry signing keys that the
# registry has since rotated, so it fails with "Cannot find matching keyid"
# before it installs anything. It also ignored the pinned `packageManager` here
# and went looking for the latest stable, which is what triggered the fetch in
# the first place.
#
# The version is read from package.json, so `packageManager` stays the single
# source of truth and this cannot drift from what developers run locally.
RUN npm install -g "pnpm@$(node -p "require('./package.json').packageManager.split('@')[1]")"

# Every root file pnpm reads before installing:
#
#   package.json         the workspace root manifest
#   pnpm-lock.yaml       the resolution to reproduce
#   pnpm-workspace.yaml  which directories are packages
#   .npmrc               linker and hoisting settings
#
# There was a fifth, .pnpmfile.cjs, and it was a trap worth remembering even
# now that it is gone: pnpm records a checksum of that file *in the lockfile*,
# so omitting it from the image made a frozen install fail with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH — a message about configuration that gives
# no hint a file is simply absent.
#
# The hook was deleted when SDK 54 brought the app to React 19 and the React
# 18 typing workaround it existed for became unnecessary. The lockfile no
# longer carries its checksum, so listing it here only broke the build with
# "failed to calculate checksum of ref ... not found" — the same failure from
# the other direction.
#
# If a root-level pnpm input is ever added back, it belongs on this line, and
# the lockfile will insist on it.
#
# This layer is cached until a dependency actually changes, so an ordinary
# source edit does not reinstall the world.
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/admin-web/package.json apps/admin-web/
COPY apps/restaurant-web/package.json apps/restaurant-web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/geography/package.json packages/geography/
COPY packages/logger/package.json packages/logger/
COPY packages/money/package.json packages/money/
COPY packages/notifications/package.json packages/notifications/
COPY packages/test-utils/package.json packages/test-utils/
COPY packages/ui-web/package.json packages/ui-web/
COPY packages/validation/package.json packages/validation/

# Everything except the mobile app.
#
# Expo and React Native are a very large tree, and nothing in the API or the
# worker imports any of it. Installing them costs build minutes and adds
# failure modes — native toolchains, platform binaries — to a build that has
# no use for the result.
#
# The manifest is still copied above: pnpm needs every workspace package.json
# present to resolve the graph, even for a package it will not install.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --filter "!@jibli/mobile"

# ── Build ────────────────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /repo
COPY . .

# Type errors fail the image rather than surfacing at runtime.
RUN pnpm --filter @jibli/api exec tsc --noEmit
RUN pnpm --filter @jibli/worker exec tsc --noEmit

RUN node scripts/bundle.mjs api
RUN node scripts/bundle.mjs worker
# Written into the API's build directory, so it ships and versions with it.
RUN node scripts/bundle.mjs migrate

# Resolve the one external dependency into a flat, copyable tree. pnpm's
# isolated linker uses symlinks that do not survive a COPY between stages.
RUN mkdir -p /runtime-deps \
 && cd /runtime-deps \
 && npm init -y >/dev/null 2>&1 \
 && npm install --omit=dev --no-audit --no-fund \
      "@node-rs/argon2@$(node -p "require('/repo/packages/auth/package.json').dependencies['@node-rs/argon2']")"

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-slim AS runtime
ENV NODE_ENV=production

# tini reaps zombies and forwards SIGTERM, so a rolling deploy actually reaches
# the graceful-shutdown handler instead of being killed after the grace period.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Never root: a container escape should not begin with UID 0.
COPY --from=build --chown=node:node /runtime-deps/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/build ./build/api
COPY --from=build --chown=node:node /repo/apps/worker/build ./build/worker

# Migrations travel with the image so a deploy applies the schema from the same
# artifact as the code, never a separately-versioned one.
COPY --from=build --chown=node:node /repo/packages/db/migrations ./migrations

# Where the runner looks for them.
#
# They were copied here from the first day and nothing pointed at them: the
# runner resolves the directory relative to its own module, which is a path
# that exists in the repository and not in a bundle at /app/build/api. So the
# image carried its schema and could not find it, the API started against a
# database two migrations older than its own code, and every request touching
# the new columns answered 500. One environment variable closes that gap.
ENV MIGRATIONS_DIR=/app/migrations

USER node

EXPOSE 4000

# Liveness only, and it touches no dependency: a probe that queried the
# database would restart a healthy API during a brief database blip.
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || process.env.API_PORT || 4000) + '/health/live') \
  .then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
# Overridden to build/worker/index.mjs for the worker service.
CMD ["node", "build/api/index.mjs"]
