# =============================================================================
# Jibli — environment template
#
# Copy to .env for local development. Never commit a real .env: secrets belong
# in a secret manager or the deployment environment (plan §7).
# Startup validation rejects a missing mandatory secret rather than failing at
# the first request that needs it.
# =============================================================================

NODE_ENV=development
APP_ENV=local
SERVICE_NAME=jibli-api
LOG_LEVEL=debug
BUSINESS_TIMEZONE=Asia/Baghdad

# ── Database ────────────────────────────────────────────────────────────────
# The runtime user must NOT be a superuser. Migrations use a separate credential.
# PostgreSQL 15+. NOT interchangeable with SQLite/Turso/D1: the schema uses
# SELECT FOR UPDATE, jsonb, COUNT(*) FILTER and AT TIME ZONE. See
# docs/operations/deployment.md.
DATABASE_URL=postgresql://jibli:jibli_local_dev@localhost:5432/jibli
DATABASE_MIGRATION_URL=postgresql://jibli:jibli_local_dev@localhost:5432/jibli
DATABASE_POOL_MAX=10
# Leave unset on a managed host: TLS is inferred from the URL. Production
# refuses to start without it either way.
DATABASE_SSL=false
# Apply pending migrations at boot, before the first request is served.
#
# Off here, because a developer runs `pnpm db:migrate` and wants to see it.
# On where there is no release phase to run it in — which is how the deployed
# API came to be two migrations ahead of its own database, answering 500 to
# every request that touched the columns those migrations add while
# /health/ready reported "ok". It is safe to leave on: the runner takes a
# Postgres advisory lock, so instances booting together apply them once.
#
# Uses DATABASE_MIGRATION_URL. That must be the DIRECT string, not a pooled
# one — see the note on it above.
RUN_MIGRATIONS_ON_BOOT=false
# Where the runner looks for its .sql files. Unset outside a container: it
# finds them next to its own module. The image sets it, because a bundle has
# no module directory to look beside.
# MIGRATIONS_DIR=/app/migrations

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=jibli:local

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# The access and refresh secrets must differ.
JWT_ACCESS_SECRET=local_dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me_fedcba9876543210
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# How long a just-rotated refresh token still works.
#
# Rotation is strict: presenting a superseded token is a replay, and a replay
# revokes every session on every device. That is right for a stolen token and
# wrong for a lost response — and a lost response is routine here, between an
# instance that sleeps and couriers on mobile data. Without this window, a
# request that timed out signed a driver out mid-delivery.
#
# 0 disables the window and restores textbook-strict rotation.
REFRESH_ROTATION_LEEWAY_SECONDS=60
# Pepper for OTP and delivery-PIN hashes. Kept out of the database on purpose.
OTP_HASH_PEPPER=local_dev_otp_pepper_change_me_0123456789abcdef
SESSION_COOKIE_NAME=jibli_session
# Required when the API and the portals sit on different subdomains, or the
# refresh cookie is never sent and every portal session dies at page load.
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# ── OTP ─────────────────────────────────────────────────────────────────────
OTP_PROVIDER=console
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_PHONE_DAY=15
OTP_MAX_PER_IP_HOUR=30
# Staging safety: comma-separated E.164 allowlist. When set, no other number
# can receive an OTP, so staging cannot text real customers.
# OTP_PHONE_ALLOWLIST=+9647712345678
#
# Numbers that always get OTP_MOCK_CODE instead of a random one, and get it
# back in the response. This is how a deployment with no SMS gateway can still
# be signed into — without OTP_PROVIDER=mock, which opens every number. These
# numbers skip the gateway entirely, so a live one is never billed for them.
# Refused outright when APP_ENV=production. Remove once SMS is connected.
# OTP_MOCK_CODE=1234
# OTP_TEST_PHONES=+9647712345678

# ── SMS OTP (a real Iraqi gateway) ──────────────────────────────────────────
#
# What makes OTP_PROVIDER=sms_gateway work, and with it sign-in from a real
# Iraqi number. The provider is deliberately generic: Iraqi OTP traffic is
# bought from local aggregators who all post the same three values under
# different names, so the names are configuration and the behaviour that
# matters — an 8s timeout, one retry on 5xx only, never logging the code — is
# not.
#
# ─ Recommended: OTPIQ (otpiq.com) ─
#
# Chosen for this market rather than on features. It is Iraq-and-Kurdistan
# only, prices in IQD, bills prepaid with no contract and no minimum, and
# signs up self-service in minutes — where Twilio and Infobip both want a
# business entity, a negotiated rate and a sender-id registration that takes
# weeks before the first message can be sent. It also fails over to WhatsApp
# and Telegram, which matters on Zain where SMS is ~2.5x the price of the
# other two networks.
#
# Setup, in order:
#   1. Sign up at otpiq.com and create a project.
#   2. Copy the project API key (it begins sk_live_).
#   3. Add credit. A verification SMS is 80-250 IQD depending on the network.
#   4. Leave SENDER_ID unset for the first send — OTPIQ's own approved sender
#      is used. Register "Jibli" in the dashboard, and only once it is
#      approved set SMS_GATEWAY_SENDER_ID below. An unapproved sender id is
#      rejected, and that is a sign-in nobody can complete.
#
# Then set OTP_PROVIDER=sms_gateway and paste the block below. Verify it
# before trusting it:  pnpm sms:test +9647XXXXXXXXX
#
# OTP_PROVIDER=sms_gateway
# SMS_GATEWAY_URL=https://api.otpiq.com/api/sms
# SMS_GATEWAY_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# SMS_GATEWAY_AUTH_SCHEME=bearer
# SMS_GATEWAY_TO_FIELD=phoneNumber
# SMS_GATEWAY_SENDER_FIELD=senderId
# OTPIQ rejects the leading +; the number goes on the wire as 9647XXXXXXXXX.
# SMS_GATEWAY_NUMBER_FORMAT=e164_no_plus
#
# Then one of the two blocks below. They differ in who writes the sentence the
# customer reads, and that decides which channels are reachable and what each
# message costs.
#
# ── A. verification mode — WhatsApp, Telegram and SMS (recommended) ──
#
# We supply the code; OTPIQ's own approved template supplies the wording. That
# is the only shape WhatsApp accepts — it will not carry free text from a
# business — and it is several times cheaper: an authentication template is
# ~25 IQD against 80–250 IQD for an SMS.
#
# The wording becomes OTPIQ's rather than NOTIFICATION_TEMPLATES', which is the
# whole of the trade.
#
#   provider=auto                  WhatsApp, then Telegram, then SMS.
#                                  Cheapest, and it degrades on its own when a
#                                  customer is not on WhatsApp.
#   provider=whatsapp-telegram-sms the same chain, stated explicitly.
#   provider=sms                   SMS only, still through their template.
#
# SMS_GATEWAY_BODY_FIELD=verificationCode
# SMS_GATEWAY_BODY_MODE=code
# SMS_GATEWAY_EXTRA_FIELDS={"smsType":"verification","provider":"auto"}
#
# ── B. custom mode — SMS only, our own Arabic wording ──
#
# We send the finished sentence from NOTIFICATION_TEMPLATES. SMS only:
# `provider` cannot be whatsapp or telegram here, because neither will carry
# free text. Costs the full SMS rate.
#
# smsType=custom is what makes OTPIQ send OUR message rather than generating a
# code of its own. Without it the customer receives a code this API never
# stored, and no sign-in can ever succeed.
#
# SMS_GATEWAY_BODY_FIELD=customMessage
# SMS_GATEWAY_BODY_MODE=text
# SMS_GATEWAY_EXTRA_FIELDS={"smsType":"custom","provider":"sms"}
#
# ── Either way ──
#
# Only once "Jibli" is approved in the OTPIQ dashboard. Max 11 characters.
# Applies to the SMS leg; WhatsApp shows the sender OTPIQ is approved for.
# SMS_GATEWAY_SENDER_ID=Jibli
#
# Try a channel before committing to it:
#   pnpm sms:test +9647XXXXXXXXX --via whatsapp
#   pnpm sms:test +9647XXXXXXXXX --via auto
#
# ─ Any other vendor ─
#
# Four questions to their docs, and every one of them is a way the integration
# fails silently — the gateway answers 200, bills you, and the phone stays
# quiet:
#
#   1. How is the number written?  +9647XXXXXXXXX / 9647XXXXXXXXX / 07XXXXXXXXX
#      → SMS_GATEWAY_NUMBER_FORMAT = e164 | e164_no_plus | national
#   2. POST JSON, POST a form, or GET a query string?
#      → SMS_GATEWAY_METHOD / SMS_GATEWAY_ENCODING
#   3. What turns on Arabic?  Almost every gateway needs a constant for it,
#      and without it the code arrives as ??? — a failure nobody notices
#      until a customer says the message made no sense.
#      → SMS_GATEWAY_EXTRA_FIELDS={"type":"unicode","route":"4"}
#   4. Does a failure come back as 4xx, or as 200 with an error inside?
#      → SMS_GATEWAY_SUCCESS_FIELD / SMS_GATEWAY_SUCCESS_VALUE
#      Leave unset for a gateway that uses status codes honestly (OTPIQ does).
#      Set them for one that does not, or every refusal is logged as a send.
#      Dotted paths reach into an envelope: data.status
#
# 5. Does it want the whole message, or just the code? A gateway with a
#    verification endpoint usually wants the digits and owns the wording —
#    and that is the only shape WhatsApp can be reached through.
#    → SMS_GATEWAY_BODY_MODE = text | code
#
# SMS_GATEWAY_METHOD=POST
# SMS_GATEWAY_ENCODING=json
# SMS_GATEWAY_BODY_MODE=text
# How the key travels: bearer | header | body.
# SMS_GATEWAY_AUTH_SCHEME=bearer
# SMS_GATEWAY_API_KEY_HEADER=X-API-Key      (when AUTH_SCHEME=header)
# SMS_GATEWAY_API_KEY_FIELD=api_key         (when AUTH_SCHEME=body)
# SMS_GATEWAY_SUCCESS_FIELD=status
# SMS_GATEWAY_SUCCESS_VALUE=success
# Where the gateway returns its own id, for matching delivery reports later.
# Guessed from the usual names (message_id, messageId, smsId, id) when unset.
# SMS_GATEWAY_MESSAGE_ID_FIELD=smsId
# SMS_GATEWAY_TIMEOUT_MS=8000

# ── WhatsApp OTP (Meta Cloud API) ───────────────────────────────────────────
#
# The delivery channel an Iraqi customer actually reads, and the one that makes
# OTP_PROVIDER=whatsapp valid in production. Every value below comes from
# WhatsApp Manager; the API refuses to boot with the provider set and the first
# two missing, rather than failing at somebody's first sign-in.
#
#   1. Verify a Meta business, create a WhatsApp Business Account, and register
#      a phone number to it — NOT a number already on the consumer WhatsApp app.
#   2. Submit a template in the AUTHENTICATION category. Utility and marketing
#      templates are refused for codes.
#   3. Create a System User and issue it a PERMANENT token. The token the
#      dashboard offers first expires in 24 hours.
#
# OTP_PROVIDER=whatsapp
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_TEMPLATE_NAME=otp_code
# WHATSAPP_TEMPLATE_LANGUAGE=ar
# Set to false only for a template with no copy-code button; Meta's own
# authentication templates have one, and a mismatch fails with 132000.
# WHATSAPP_HAS_COPY_BUTTON=true
# WHATSAPP_API_VERSION=v21.0

# ── Storage ─────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=jibli-public
S3_PRIVATE_BUCKET=jibli-private
S3_ACCESS_KEY_ID=jibli_local
S3_SECRET_ACCESS_KEY=jibli_local_dev_secret
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Restaurant portal :3000, Admin portal :3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
RATE_LIMIT_GLOBAL_PER_MINUTE=300
REQUEST_BODY_LIMIT_BYTES=1048576

# ── Notifications ───────────────────────────────────────────────────────────
PUSH_PROVIDER=console

# ── Observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
SETTLEMENT_CRON=0 2 * * *
RECONCILIATION_CRON=30 2 * * *
