    "@jibli/domain": "workspace:*",
    "@jibli/logger": "workspace:*",
    "@jibli/money": "workspace:*",
    "@jibli/notifications": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
