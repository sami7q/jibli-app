{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Pinning "react" forces every type reference made from inside this
      // project — including those in dependency .d.ts files — to resolve to
      // the app's own React typings rather than whichever copy a dependency
      // happens to pull from the workspace.
      //
      // It was written for a React 18/19 split that no longer exists: SDK 54
      // brought the app to React 19, which is what the portals already ran.
      // It stays because the workspace still holds several @types/react
      // minors, and two of those disagreeing about ReactNode produces the
      // same unreadable "JSX is incompatible" report the split did.
      //
      // These mappings are for TypeScript only. Metro must NOT follow them —
      // `react` would resolve to a package with no JavaScript in it and the app
      // would fail to bundle — so `experiments.tsconfigPaths` is off in
      // app.config.ts and the `@/` alias is handled by babel.config.js instead.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "types": ["react", "node"]
  },
  // `.expo/types` carries the generated route types for `typedRoutes`, and
  // `expo-env.d.ts` the ambient module declarations. Both are generated by the
  // dev server and git-ignored; a fresh clone simply has fewer types until it
  // runs once.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/*.d.ts",
    "app.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
