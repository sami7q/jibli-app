{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // React Native 0.76 is React 18 while the web portals are React 19.
      // Pinning "react" here forces every type reference made from inside this
      // project — including those in dependency .d.ts files — to resolve to the
      // app's own React 18 typings. Without it the navigation stack resolves
      // the workspace's React 19 copy, whose ReactNode admits bigint, and its
      // JSX is reported as incompatible with the app's own. See .pnpmfile.cjs.
      //
      // These mappings are for TypeScript only. Metro must NOT follow them —
      // `react` would resolve to a package with no JavaScript in it and the app
      // would fail to bundle — so `experiments.tsconfigPaths` is off in
      // app.config.ts and the `@/` alias is handled by babel.config.js instead.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "types": ["react", "node"]
  },
  // `.expo/types` carries the generated route types for `typedRoutes`, and
  // `expo-env.d.ts` the ambient module declarations. Both are generated by the
  // dev server and git-ignored; a fresh clone simply has fewer types until it
  // runs once.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
