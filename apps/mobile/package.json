{
  "name": "@jibli/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export -p ios -p android --output-dir .expo-export",
    "web": "expo start --web",
    "proxy": "node scripts/dev-proxy.mjs",
    "check": "node scripts/preflight.mjs",
    "apk": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/cairo": "^0.2.3",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@jibli/contracts": "workspace:*",
    "@jibli/design-tokens": "workspace:*",
    "@jibli/money": "workspace:*",
    "@jibli/validation": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~57.0.23",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.18",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^3.24.1"
  },
  "expo": {
    "install": {
      "//": "SDK 57 pairs with TypeScript 6, and this is one package in a workspace of nineteen that share one compiler. Moving all of them to a major release to satisfy a version table is a change with its own risk and no benefit here: the app typechecks clean on 5.9.3 and `expo export` produces both bundles. It moves when the monorepo moves.",
      "exclude": [
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.12",
    "typescript": "^5.7.2"
  }
}
